<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layoutDirection="rtl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/project_card_background"
            android:padding="24dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvProjectName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اسم المشروع"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvOwnerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="بواسطة: المستخدم"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:alpha="0.9"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الوصف"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔧 اللغة"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:background="@drawable/language_badge"
                android:padding="8dp" />

            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/white"
                android:alpha="0.2"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/layoutPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔗 رابط المعاينة:"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvPreviewLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="https://example.com"
                    android:textSize="13sp"
                    android:textColor="@android:color/white"
                    android:autoLink="web"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnOpenPreview"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="فتح رابط المعاينة"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/gradient_button"
                    android:layout_marginBottom="12dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutGithub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGithubLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💻 رابط GitHub:"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvGithubLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="https://github.com/user/repo"
                    android:textSize="13sp"
                    android:textColor="@android:color/white"
                    android:autoLink="web"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnOpenGithub"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="فتح رابط GitHub"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/gradient_button" />
            </LinearLayout>

            <Button
                android:id="@+id/btnContactOwner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="💬 تواصل مع صاحب المشروع"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:background="@drawable/gradient_button"
                android:layout_marginTop="16dp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="قيّم هذا المشروع"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnRateWeak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ضعيف"
                android:textColor="@android:color/white"
                android:background="@drawable/rating_weak"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnRateGood"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="جيد"
                android:textColor="@android:color/white"
                android:background="@drawable/rating_good"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnRateExcellent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ممتاز"
                android:textColor="@android:color/white"
                android:background="@drawable/rating_excellent"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvWeakCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 تقييم"
                android:gravity="center"
                android:textColor="#EF4444" />

            <TextView
                android:id="@+id/tvGoodCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 تقييم"
                android:gravity="center"
                android:textColor="#F59E0B" />

            <TextView
                android:id="@+id/tvExcellentCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 تقييم"
                android:gravity="center"
                android:textColor="#10B981" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="التعليقات"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxBackgroundColor="@android:color/white"
            app:boxStrokeColor="#2196F3"
            app:hintTextColor="#2196F3"
            app:boxBackgroundMode="outline">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="اكتب تعليقك..."
                android:textColor="#000000"
                android:textColorHint="#757575"
                android:textSize="16sp"
                android:padding="16dp"
                android:inputType="textMultiLine"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnAddComment"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="إضافة تعليق"
            android:textColor="@android:color/white"
            android:background="@drawable/gradient_button"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:id="@+id/commentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
